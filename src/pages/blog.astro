---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Parser from "rss-parser";

interface Post {
  title: string;
  link: string;
  pubDate: string;
  image: string | null;
}

const parser = new Parser({
  customFields: { item: [["content:encoded", "contentEncoded"]] },
});

let posts: Post[] = [];
try {
  const feed = await parser.parseURL("https://medium.com/feed/@ahmadshamius2");
  posts = feed.items.map((item) => {
    const html = (item as any).contentEncoded ?? item.content ?? "";
    const imgMatch = html.match(/<img[^>]+src="([^"]+)"/);
    return {
      title: item.title ?? "Untitled",
      link: item.link ?? "#",
      pubDate: item.pubDate
        ? new Date(item.pubDate).toLocaleDateString("en-GB", {
            day: "numeric",
            month: "short",
            year: "numeric",
          })
        : "",
      image: imgMatch ? imgMatch[1] : null,
    };
  });
} catch (err) {
  console.error("Failed to fetch Medium feed:", err);
}
---
<Layout title="Blog">
  <Nav />
  <main class="space-y-6">
    <p class="text-sm text-muted">
      Posts pulled from
      <a 
        href="https://medium.com/@ahmadshamius2"
        class="text-paper underline decoration-panel underline-offset-4 hover:decoration-accent"
      > my Medium
      </a>.
    </p>

    {posts.length === 0 && (
      <p class="text-muted">No posts yet — check back soon.</p>
    )}

    <div class="grid gap-4 sm:grid-cols-2">
      {posts.map((post) => (
      <a
          href={post.link}
          target="_blank"
          rel="noreferrer"
          class="group flex flex-col overflow-hidden rounded-sm border border-panel bg-panel/40 transition-all duration-150 ease-out hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-[0_10px_24px_-14px_rgba(201,138,59,0.4)]"
        >
          {post.image && (
            <img
              src={post.image}
              alt=""
              class="h-40 w-full object-cover grayscale transition-[filter] duration-150 group-hover:grayscale-0"
            />
          )}
          <div class="flex flex-1 flex-col gap-2 px-4 py-3">
            <h3 class="text-paper/90 transition-colors group-hover:text-paper">
              {post.title}
            </h3>
            <span class="mt-auto font-mono text-xs text-muted">
              {post.pubDate}
            </span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
