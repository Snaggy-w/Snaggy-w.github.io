---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---
<Layout title="CV">
  <Nav />
  <main class="space-y-10 leading-relaxed text-paper/90">
    <div>
      <h2 class="text-xl font-semibold">Curriculum Vitae</h2>
      <div class="mt-4 flex flex-wrap gap-3">
	<a
          href="/cv.pdf"
          download
          class="group inline-flex items-center gap-2 rounded-sm border border-panel bg-panel/40 px-4 py-2 text-sm text-paper/90 transition-all duration-150 ease-out hover:-translate-y-0.5 hover:border-accent/60 hover:bg-panel hover:text-paper hover:shadow-[0_10px_24px_-14px_rgba(201,138,59,0.4)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 text-muted transition-colors group-hover:text-accent">
            <path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16" />
          </svg>
          Download CV (PDF)
        </a>
        <!-- TO DO: Maybe I will add option to download Latex Source of my cv -->
      </div>
    </div>
  </main>
</Layout>
