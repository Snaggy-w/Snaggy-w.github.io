---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { education } from "../data/education";
import { experience } from "../data/experience";
---
<Layout title="Education">
  <Nav />
  <main class="space-y-24">
    <section>
      <h2 class="font-mono text-sm text-muted">Education</h2>
      <div class="mt-6 divide-y divide-panel border-t border-panel">
        {education.map((entry) => (
          <div class="py-8 first:pt-0">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-semibold text-paper">{entry.title}</h3>
              <span class="font-mono text-xs text-muted">{entry.period}</span>
            </div>
            <p class="mt-1 text-sm text-muted">{entry.institution}</p>
            <p class="mt-2 leading-relaxed text-paper/90">{entry.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="font-mono text-sm text-muted">Professional Experience</h2>
      <div class="mt-6 divide-y divide-panel border-t border-panel">
        {experience.map((entry) => (
          <div class="py-8 first:pt-0">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-semibold text-paper">{entry.title}</h3>
              <span class="font-mono text-xs text-muted">{entry.period}</span>
            </div>

            {entry.summary && (
              <p class="mt-2 leading-relaxed text-paper/90">{entry.summary}</p>
            )}

            {entry.groups && (
              <div class="mt-3 space-y-4">
                {entry.groups.map((group) => (
                  <div>
                    <p class="font-medium text-paper/90">{group.heading}</p>
                    <ul class="mt-1 list-disc space-y-1 pl-5 text-sm leading-relaxed text-muted">
                      {group.bullets.map((bullet) => <li>{bullet}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
